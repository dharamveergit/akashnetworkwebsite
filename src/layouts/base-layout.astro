---
import "@/styles/globals.css";

import TailwindIndicator from "@/components/tailwind-indicator.astro";
import BaseHead from "@/components/base-head.astro";
import Header from "@/components/header/header.astro";
import Footer from "@/components/footer/footer.astro";
import { ViewTransitions } from "astro:transitions";
import CTA from "@/components/CTA.astro";
import AsideTailwindClasses from "@/lib/aside/aside-tailwind-classes.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  classname?: string;
  noIndex?: boolean;
}

const { title, description, image, classname, noIndex } = Astro.props;

const isProd = import.meta.env.PROD;

const onlyDark = false;

const htmlClasses = [
  "scroll-pt-[137px]",
  "scroll-smooth",
  ...(onlyDark ? ["dark"] : []),
];

const htmlDataTheme = onlyDark ? "dark-plus" : undefined;
---

<!doctype html>
<html
  lang="en"
  style="scrollbar-gutter: stable;"
  class={htmlClasses.join(" ")}
  data-only-dark={onlyDark ? "true" : "false"}
  data-theme={htmlDataTheme}
>
  <head>
    <!-- Critical CSS inline for instant rendering -->
    <style is:inline>
      /* Critical above-the-fold styles */
      html {
        scroll-behavior: smooth;
        scrollbar-gutter: stable;
      }
      body {
        margin: 0;
        background-color: #fff;
        color: #1a1a1a;
        font-family:
          Inter,
          system-ui,
          -apple-system,
          sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      .dark body {
        background-color: #1c1c1c;
        color: #ededed;
      }
      * {
        box-sizing: border-box;
      }
      [data-critical] {
        display: block;
      }
    </style>
    <script is:inline>
      /**
       * CRITICAL: Defer non-critical CSS - Must run first before any stylesheets
       * This prevents render-blocking by converting non-critical CSS to async loading
       */
      (function () {
        const deferStylesheet = (link) => {
          if (
            link.dataset.asyncLoaded ||
            link.dataset.critical ||
            link.media === "print"
          ) {
            return;
          }

          // Mark first stylesheet as critical (usually globals.css)
          if (
            !document.querySelector('link[rel="stylesheet"][data-critical]')
          ) {
            link.setAttribute("data-critical", "true");
            return;
          }

          // Defer all other stylesheets using print media technique
          const originalMedia = link.media || "all";
          link.media = "print";
          link.setAttribute("data-async-loaded", "true");

          const activateStylesheet = () => {
            link.media = originalMedia;
          };

          link.addEventListener("load", activateStylesheet);
          link.addEventListener("error", activateStylesheet);
          setTimeout(activateStylesheet, 3000); // Fallback timeout
        };

        // Process existing stylesheets immediately
        if (document.head) {
          document
            .querySelectorAll('link[rel="stylesheet"]')
            .forEach(deferStylesheet);
        }

        // Watch for dynamically added stylesheets
        let observer = null;

        const startObserver = () => {
          if (document.head && !observer) {
            observer = new MutationObserver((mutations) => {
              mutations.forEach((mutation) => {
                mutation.addedNodes.forEach((node) => {
                  if (
                    node.nodeName === "LINK" &&
                    node.rel === "stylesheet" &&
                    !node.dataset.asyncLoaded
                  ) {
                    deferStylesheet(node);
                  }
                });
              });
            });

            observer.observe(document.head, {
              childList: true,
              subtree: true,
            });

            // Also check existing stylesheets
            document
              .querySelectorAll('link[rel="stylesheet"]')
              .forEach(deferStylesheet);

            // Cleanup on pagehide for bfcache compatibility
            window.addEventListener(
              "pagehide",
              () => {
                if (observer) {
                  observer.disconnect();
                  observer = null;
                }
              },
              { once: true }
            );
          }
        };

        if (document.head) {
          startObserver();
        } else {
          // Wait for head, checking frequently
          const checkHead = setInterval(() => {
            if (document.head) {
              clearInterval(checkHead);
              startObserver();
            }
          }, 1);
        }

        // Handle bfcache restoration
        window.addEventListener("pageshow", (event) => {
          if (event.persisted) {
            // Page was restored from bfcache, restart observer if needed
            if (!observer && document.head) {
              startObserver();
            }
          }
        });
      })();
    </script>
    <!-- Google Analytics - Deferred to not block rendering -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LFRGN2J2RV"></script>
    <script is:inline>
      // Critical theme initialization - runs immediately
      const doc = document.documentElement;
      if (doc.dataset.onlyDark === "true") {
        doc.classList.add("dark");
        doc.setAttribute("data-theme", "dark-plus");
        try {
          localStorage.setItem("theme", "dark");
        } catch {}
      }
    </script>
    <script is:inline>
      // Google Analytics - Deferred until after initial render
      (function () {
        const initGA = () => {
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", "G-LFRGN2J2RV");
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initGA);
        } else {
          setTimeout(initGA, 0);
        }
      })();
    </script>

    <!-- Start of HubSpot Embed Code - Deferred -->
    <script
      is:inline
      type="text/javascript"
      id="hs-script-loader"
      async
      defer
      src="//js.hs-scripts.com/47519938.js"
    ></script><!-- End of HubSpot Embed Code -->

    <!-- Google Tag Manager - Deferred to not block rendering -->
    <script is:inline>
      // GTM - Deferred until after initial render
      (function () {
        const initGTM = () => {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-573RDG5H");
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initGTM);
        } else {
          setTimeout(initGTM, 0);
        }
      })();
    </script>

    <BaseHead
      title={title}
      description={description}
      image={image}
      noIndex={noIndex}
    />
    <!-- MathJax - Deferred, not critical for initial render -->
    <script is:inline>
      // MathJax - Deferred until after initial render
      (function () {
        const initMathJax = () => {
          const queueMathTypeset = () => {
            if (window.MathJax?.typesetPromise) {
              window.MathJax.typesetClear?.();
              window.MathJax.typesetPromise();
            }
          };

          window.MathJax = {
            tex: {
              inlineMath: [
                ["$", "$"],
                ["\\(", "\\)"],
              ],
              displayMath: [
                ["$$", "$$"],
                ["\\[", "\\]"],
              ],
              processEscapes: true,
            },
            options: {
              skipHtmlTags: [
                "script",
                "noscript",
                "style",
                "textarea",
                "pre",
                "code",
              ],
            },
            startup: {
              ready: () => {
                const { MathJax } = window;
                MathJax.startup.defaultReady();
                queueMathTypeset();
              },
            },
          };

          document.addEventListener("astro:after-swap", queueMathTypeset);
        };

        // Load MathJax after page is interactive
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", () => {
            setTimeout(initMathJax, 100);
          });
        } else {
          setTimeout(initMathJax, 100);
        }
      })();
    </script>
    <script
      defer
      id="mathjax"
      src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
    <ViewTransitions />
  </head>
  <body class="bg-background" class:list={classname}>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WT4KSXNQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <slot />
    <AsideTailwindClasses />

    {!isProd && <TailwindIndicator />}

    <script>
      const onlyDark = document.documentElement.dataset.onlyDark === "true";

      const getTheme = () => {
        if (onlyDark) {
          localStorage.setItem("theme", "dark");
          return "dark";
        }

        const savedTheme = localStorage.getItem("theme");
        if (savedTheme) return savedTheme;

        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };
      const setTheme = (theme: string) => {
        const appliedTheme = onlyDark ? "dark" : theme;

        if (appliedTheme === "light") {
          document.documentElement.classList.remove("dark");
          document.documentElement.setAttribute("data-theme", "light-plus");
        } else {
          document.documentElement.classList.add("dark");
          document.documentElement.setAttribute("data-theme", "dark-plus");
        }

        if (onlyDark) {
          localStorage.setItem("theme", "dark");
        } else {
          localStorage.setItem("theme", appliedTheme);
        }
      };

      const applyTheme = () => setTheme(getTheme());

      // Apply theme on load and bfcache restore
      const initTheme = () => {
        applyTheme();
      };

      // Handle initial load and bfcache restoration
      if (document.readyState === "loading") {
        window.addEventListener("DOMContentLoaded", initTheme);
      } else {
        initTheme();
      }

      // Handle Astro view transitions
      document.addEventListener("astro:after-swap", applyTheme);

      // Handle bfcache restoration
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          // Page restored from bfcache, reapply theme
          applyTheme();
        }
      });

      const handleHeaderToggleClick = () => {
        if (onlyDark) return;

        const element = document.documentElement;
        element.classList.toggle("dark");

        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        document.documentElement.setAttribute(
          "data-theme",
          isDark ? "dark-plus" : "light-plus"
        );
      };

      if (!onlyDark) {
        document
          .querySelectorAll("#header-toggle")
          .forEach((el) =>
            el.addEventListener("click", handleHeaderToggleClick)
          );

        document
          .querySelectorAll("#header-toggle-footer")
          .forEach((el) =>
            el.addEventListener("click", handleHeaderToggleClick)
          );
        document
          .querySelectorAll("#header-toggle-nav")
          .forEach((el) =>
            el.addEventListener("click", handleHeaderToggleClick)
          );
      }
    </script>
    <script>
      const onlyDark = document.documentElement.dataset.onlyDark === "true";

      // Type definitions
      type Theme = any;
      type MermaidConfig = {
        startOnLoad: boolean;
        fontFamily: string;
        theme: Theme;
      };

      interface MermaidAPI {
        initialize: (config: MermaidConfig) => void;
        render: (id: string, content: string) => Promise<{ svg: string }>;
      }

      declare module "mermaid" {
        const mermaid: MermaidAPI;
      }

      // Store original content to allow re-rendering
      const diagramContents = new Map();

      const getTheme = (): Theme => {
        if (onlyDark) {
          localStorage.setItem("theme", "dark");
          return "dark";
        }

        const savedTheme = localStorage.getItem("theme") as Theme | null;
        if (savedTheme) return savedTheme;

        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "neutral";
      };

      async function renderDiagrams(
        graphs: HTMLCollectionOf<Element>,
        theme?: Theme
      ) {
        const { default: mermaid } = await import("mermaid");

        // Reset mermaid with new theme
        const resolvedTheme = onlyDark ? "dark" : theme || getTheme();
        mermaid.initialize({
          startOnLoad: false,
          fontFamily: "var(--sans-font)",
          theme: resolvedTheme,
        });

        Array.from(graphs).forEach(async (graph) => {
          // Get content either from our stored map or from the element
          let content = diagramContents.get(graph);
          if (!content) {
            const contentElement = graph.querySelector(".mermaid-src");
            content = contentElement?.textContent || "";
            if (content) {
              diagramContents.set(graph, content);
            }
          }

          if (!content) return;

          // Clear the graph before re-rendering
          graph.innerHTML = "";

          const svg = document.createElement("svg");
          const id = `mermaid-${Math.round(Math.random() * 100000)}`;
          svg.id = id;

          graph.appendChild(svg);
          try {
            const result = await mermaid.render(id, content);
            graph.innerHTML = result.svg;
          } catch (error) {
            console.error("Failed to render mermaid diagram:", error);
            // Restore original content on error
            const contentElement = document.createElement("div");
            contentElement.className = "mermaid-src";
            contentElement.textContent = content;
            graph.appendChild(contentElement);
          }
        });
      }

      // Initial render
      const graphs = document.getElementsByClassName("mermaid");
      if (graphs.length > 0) {
        renderDiagrams(graphs);
      }

      // Watch for theme changes in localStorage (bfcache-friendly)
      const handleStorageChange = (e: StorageEvent) => {
        if (e.key === "theme") {
          const graphs = document.getElementsByClassName("mermaid");
          if (graphs.length > 0) {
            const nextTheme = onlyDark ? "dark" : (e.newValue as Theme);
            renderDiagrams(graphs, nextTheme);
          }
        }
      };

      window.addEventListener("storage", handleStorageChange);

      // Cleanup on pagehide for bfcache
      window.addEventListener(
        "pagehide",
        () => {
          window.removeEventListener("storage", handleStorageChange);
        },
        { once: true }
      );

      // Re-attach on bfcache restore
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          window.addEventListener("storage", handleStorageChange);
        }
      });

      // Watch for system theme changes (bfcache-friendly)
      const darkModeMediaQuery = window.matchMedia(
        "(prefers-color-scheme: dark)"
      );

      const handleSystemThemeChange = (e: MediaQueryListEvent) => {
        if (!localStorage.getItem("theme")) {
          const graphs = document.getElementsByClassName("mermaid");
          if (graphs.length > 0) {
            const nextTheme = onlyDark
              ? "dark"
              : e.matches
                ? "dark"
                : "neutral";
            renderDiagrams(graphs, nextTheme);
          }
        }
      };

      darkModeMediaQuery.addEventListener("change", handleSystemThemeChange);

      // Cleanup on pagehide for bfcache
      window.addEventListener(
        "pagehide",
        () => {
          darkModeMediaQuery.removeEventListener(
            "change",
            handleSystemThemeChange
          );
        },
        { once: true }
      );

      // Re-attach on bfcache restore
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          darkModeMediaQuery.addEventListener(
            "change",
            handleSystemThemeChange
          );
        }
      });

      // Function to handle manual theme changes
      function updateMermaidTheme(newTheme: Theme): void {
        const graphs = document.getElementsByClassName("mermaid");
        if (graphs.length > 0) {
          const nextTheme = onlyDark ? "dark" : newTheme;
          renderDiagrams(graphs, nextTheme);
        }
      }

      // Make updateMermaidTheme available globally
      (window as any).updateMermaidTheme = updateMermaidTheme;

      // Add a mutation observer to watch for theme attribute changes on body or html
      let mermaidObserver: MutationObserver | null = null;

      const startMermaidObserver = () => {
        if (!mermaidObserver) {
          mermaidObserver = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
              if (
                mutation.attributeName === "data-theme" ||
                mutation.attributeName === "class"
              ) {
                const graphs = document.getElementsByClassName("mermaid");
                if (graphs.length > 0) {
                  renderDiagrams(graphs, getTheme());
                }
              }
            });
          });

          // Start observing the document with the configured parameters
          mermaidObserver.observe(document.documentElement, {
            attributes: true,
          });
          mermaidObserver.observe(document.body, { attributes: true });

          // Cleanup on pagehide for bfcache
          window.addEventListener(
            "pagehide",
            () => {
              if (mermaidObserver) {
                mermaidObserver.disconnect();
                mermaidObserver = null;
              }
            },
            { once: true }
          );
        }
      };

      startMermaidObserver();

      // Re-attach on bfcache restore
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          startMermaidObserver();
        }
      });
    </script>
    <script
      is:inline
      async
      src="https://pxl.growth-channel.net/s/8d425860-cf3c-49cf-a459-069a7dc7b1f8"
    ></script>
  </body>
</html>
