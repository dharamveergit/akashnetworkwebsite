---
import { cn } from "@/lib/utils";
import { buttonVariants } from "./button-link-variants";

interface Props {
  variant?: "primary" | "secondary" | "tagButton";
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  className?: string;
  link?: string;
  isActive?: boolean;
  target?: "_self" | "_blank";
  "aria-label"?: string;
  download?: string;
  id?: string;
  arrow?: boolean;
}

const {
  variant,
  size,
  className,
  link,
  isActive = false,
  target = "_self",
  "aria-label": ariaLabel,
  download,
  id,
  arrow = false,
  ...props
} = Astro.props;
---

<a
  id={id}
  aria-label={ariaLabel ?? ""}
  href={link}
  download={download}
  target={link ? (link.startsWith("http") ? "_blank" : "_self") : "_self"}
  rel="noopener noreferrer"
>
  <button
    aria-label={ariaLabel}
    {...props}
    class={cn(buttonVariants({ variant, size, className }))}
  >
    {
      arrow && (
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M7.64062 12.3574L12.3547 7.64331M12.3547 7.64331H8.22988M12.3547 7.64331V11.7681"
            stroke="currentColor"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
          <path
            d="M9.9974 18.3334C14.5997 18.3334 18.3307 14.6024 18.3307 10.0001C18.3307 5.39771 14.5997 1.66675 9.9974 1.66675C5.39502 1.66675 1.66406 5.39771 1.66406 10.0001C1.66406 14.6024 5.39502 18.3334 9.9974 18.3334Z"
            stroke="currentColor"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
        </svg>
      )
    }
    <slot />
  </button>
</a>
